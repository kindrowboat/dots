# Turn CanonicalizeHostname on for Match to work below.
CanonicalizeHostname yes

# Defaults for all Wikimedia Foundation hosts.
Match host "*.wikimedia.org,*.wmnet"
    ForwardAgent no
    IdentitiesOnly yes
    KbdInteractiveAuthentication no
    PasswordAuthentication no
    User kindrobot

# geographically prefered bastion for WMF production deploy servers
Host bast
    HostName bast1003.wikimedia.org
    IdentityFile ~/.ssh/wmf_prod.key
    User kindrobot

# defaults for any other WMF production bastions we might encounter
Host bast*.wikimedia.org
    IdentityFile ~/.ssh/wmf_prod.key

# WMF deployment production servers, routed through a bastion
Host *.wmnet *.wikimedia.org !gerrit.wikimedia.org !bast*.wikimedia.org !gitlab.wikimedia.org
    ProxyJump bast
    IdentityFile ~/.ssh/wmf_prod.key


# wikimedia's gerrit
Host gerrit.wikimedia.org
    Port 29418
    IdentityFile ~/.ssh/wmf_gerrit_ed25519.key.pub
    RequiredRSASize 1024

# WMF CloudVPS access (including toolforge)
Host *.wmflabs.org *.wmcloud.org *.toolforge.org
    User kindrobot
    IdentityFile ~/.ssh/wmf_cloudvps_ed25519.key.pub

Host *.wmflabs *.wikimedia.cloud
    User kindrobot
    ProxyJump bastion.wmcloud.org:22
    IdentityFile ~/.ssh/wmf_cloudvps_ed25519.key.pub

Host gitlab.wikimedia.org
    IdentityFile ~/.ssh/wmf_gitlab_ed25519.key.pub

Host tilde.town
    HostName tilde.town
    User kind
    #IdentityFile ~/.ssh/id_ed25519
    IdentityFile ~/.ssh/town_ed25519.key.pub
    ForwardAgent yes
    AddressFamily inet

Host team
    HostName tilde.team
    User kindrobot
    ForwardAgent yes
    IdentityFile ~/.ssh/id_ed25519

Host github.com
    IdentityFile ~/.ssh/github_ed25519.key.pub

Host lesbians.kindrobot.ca
    HostName lesbians.kindrobot.ca
    User kindrobot
    ForwardAgent yes
    IdentityFile ~/.ssh/lesbians_ed25519.key.pub

Host acai
    HostName 23.23.30.15
    User kindrobot
    ForwardAgent yes
    Port 46822
    IdentityFile ~/.ssh/acai_ed25519.key.pub


Host skylab.org
    IdentityFile ~/.ssh/skylab_ed25519.key.pub
    User kind

Host sdf.org
    User kind
    #PreferredAuthentications password
    #PubkeyAuthentication no
    IdentityFile ~/.ssh/sdf_ed25519.key.pub

Host coop.coloc.systems
    User coop
    IdentityFile ~/.ssh/coop_coloc_ed25519.key.pub


Host kindbsd.coloc.systems
        User kind
        IdentityFile ~/.ssh/kindbsd_ed25519.key.pub
        IdentitiesOnly yes

Host git.gay
    User git
    IdentityFile ~/.ssh/git_gay_ed25519.key.pub
    IdentitiesOnly yes

Host blahaj.local
    User coop
    IdentityFile ~/.ssh/blahaj_ed25519.key.pub
    IdentitiesOnly yes

Host casper.local
    User kind
    IdentityFile ~/.ssh/casper_ed25519.key.pub
    IdentitiesOnly yes

